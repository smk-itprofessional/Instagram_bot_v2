# Copy to .env (local only, never commit)
IG_USER_ID=
IG_ACCESS_TOKEN=
IMGBB_API_KEY=
DRY_RUN=true
IG_API_VERSION=v26.0
# Quotes: file = 365-bank (default, unique), live = free text model
QUOTE_SOURCE=file
# Text on image: true to burn quote onto photo, false for clean background
QUOTE_ON_IMAGE=true
# Caption prefix for develop runs on same IG account, e.g. "[DEV] "
CAPTION_PREFIX=
